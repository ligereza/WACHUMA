{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wachuma.org/schemas/scroll-experience.schema.json",
  "title": "WACHUMA Scroll Experience",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicId",
    "biologicalEntityPublicId",
    "title",
    "subtitle",
    "modelUri",
    "representationType",
    "chapters",
    "fallbackText"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "publicId": { "type": "string", "minLength": 1 },
    "biologicalEntityPublicId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "modelUri": { "type": "string", "minLength": 1 },
    "representationType": {
      "enum": ["procedural-interpretation", "artistic-representation"]
    },
    "fallbackText": { "type": "string", "minLength": 1 },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eyebrow",
        "title",
        "body",
        "layer",
        "sourcePublicIds",
        "camera",
        "rotationTurns",
        "accent"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "layer": { "type": "string", "minLength": 1 },
        "sourcePublicIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distance", "height", "targetHeight", "fov"],
          "properties": {
            "distance": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number" },
            "targetHeight": { "type": "number" },
            "fov": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "rotationTurns": { "type": "number" },
        "accent": { "type": "string", "minLength": 1 },
        "status": { "enum": ["published", "research-pending"] }
      }
    }
  }
}
