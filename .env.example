POSTGRES_DB=wachuma
POSTGRES_USER=wachuma
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://wachuma:change-me@localhost:5432/wachuma
WACHUMA_API_URL=http://localhost:3001
WACHUMA_ADMIN_TOKEN=change-me-in-development
NEXT_PUBLIC_WACHUMA_API_URL=http://localhost:3001
# Solo para desarrollo sin API; con false la web no oculta fallos usando fixtures.
WACHUMA_DEMO_MODE=false
# Opcional: filtra ocurrencias GBIF por licencia declarada en el proveedor.
# GBIF_OCCURRENCE_LICENSE=CC_BY_4_0
# GBIF_OCCURRENCE_MEDIA_TYPE=StillImage
# Importación iNaturalist acotada y siempre pendiente de revisión editorial.
# INATURALIST_IMPORT_NAME=Echinopsis pachanoi
# INATURALIST_PER_PAGE=5
# INATURALIST_QUALITY_GRADE=research
# INATURALIST_OBSERVATION_LICENSE=cc-by,cc0
# INATURALIST_PHOTO_LICENSE=cc-by,cc0
# INATURALIST_OPEN_GEO_ONLY=true
# Importación de claims estructurados Wikidata; siempre queda pending para revisión.
# WIKIDATA_QID=Q133426
# O bien busca por nombre científico:
# WIKIDATA_IMPORT_NAME=Echinopsis pachanoi
# WIKIDATA_LANGUAGE=en
# Staging opcional de un snapshot FungalTraits obtenido externamente.
# FUNGALTRAITS_SNAPSHOT_PATH=.local/fungaltraits/snapshot.csv
# FUNGALTRAITS_RELEASE_VERSION=release-to-review
# FUNGALTRAITS_SNAPSHOT_URL=https://example.org/fungaltraits/snapshot.csv
# FUNGALTRAITS_DOI=https://doi.org/example
# FUNGALTRAITS_CITATION=Pending citation review
# FUNGALTRAITS_LICENSE=unknown
# FUNGALTRAITS_ATTRIBUTION=Pending attribution review
# FUNGALTRAITS_LICENSE_REVIEW=unresolved
# FUNGALTRAITS_LICENSE_EVIDENCE_URL=https://example.org/license
